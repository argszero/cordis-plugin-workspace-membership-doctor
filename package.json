{
  "name": "@argszero/cordis-plugin-workspace-membership-doctor",
  "version": "0.1.0",
  "description": "Diagnoses and heals workspace membership lost to a header index that was incomplete when a write pruned it: the durable workspace record drops a session whose stored cwd still names that workspace, and nothing ever re-attaches it. The plugin censuses stored headers against the registry's own canonicalizer and re-attaches candidates through the registry's existing public `attachSession`, which validates the cwd itself. It writes nothing unless asked.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argszero/cordis-plugin-workspace-membership-doctor.git"
  },
  "homepage": "https://github.com/argszero/cordis-plugin-workspace-membership-doctor#readme",
  "bugs": {
    "url": "https://github.com/argszero/cordis-plugin-workspace-membership-doctor/issues"
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "session",
    "membership",
    "diagnostics",
    "tool"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1 <0.1.7-rc.1 || >=0.2.0-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-alpha.1 <0.1.7-rc.1 || >=0.2.0-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.1.7-rc.1 || >=0.2.0-rc.1 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.7-alpha.1 <0.1.7-rc.1 || >=0.2.0-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "^24.19.0",
    "semver": "^7.6.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "test:probe-lines": "node scripts/probe-lines.mjs",
    "test:inject": "node scripts/inject-defects.mjs",
    "prepublishOnly": "tsc"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
